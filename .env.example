# Nopaste configuration example
# ------------------------------------------------------------------------------
# 1. Copy this file to .env
# 2. Fill in the real values
# 3. Never commit .env (it is already in .gitignore)
#
# All variables are case-insensitive. See src/config.py for the full list.
# ------------------------------------------------------------------------------

# Server
APP_PORT=8000

# Set to true only for local development
DEBUG=false

# Storage backend
# - Local/dev default: SQLite via DATABASE_PATH
# - Production: PostgreSQL via DATABASE_URL or discrete POSTGRES_* vars
#   (DATABASE_URL wins when set; otherwise POSTGRES_HOST+DB+USER(+PASSWORD))
DATABASE_PATH=/tmp/pastes.db
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable

# Optional at-rest encryption for paste bodies (Fernet).
# Leave empty/unset to store plaintext (default).
# When set, new writes are stored as enc:v1:<ciphertext>;
# legacy plaintext rows remain readable after enabling the key.
# Accepts a Fernet key (url-safe base64) or any passphrase (SHA-256 derived).
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PASTE_ENCRYPTION_KEY=

# HMAC secret used to sign the "user_pastes" cookie.
# MUST be changed for every environment (especially production)!
# Generate a strong value:
#   openssl rand -hex 32
#   python -c 'import secrets; print(secrets.token_hex(32))'
COOKIE_SIGNING_SECRET=replace-with-long-random-hex-string-min-32-bytes

# Paste size and history limits (defaults are usually fine)
MAX_PASTE_SIZE_BYTES=100000
MAX_RECENT_PASTES=50

# --------------------------------------------------------------------------
# URL shortener (Shlink)
# Set BOTH to enable automatic short link generation for pastes.
# Leave empty (or omit) to disable shortening entirely.
# --------------------------------------------------------------------------
SHRINK_URL=
SHRINK_TOKEN=

# Public base URL used for:
# - Open Graph / Twitter meta tags
# - Absolute links in the UI
# - Canonical URLs
#
# Examples:
#   http://localhost:8000
#   https://paste.example.com
PUBLIC_BASE_URL=

# Active UI design (see templates/designs/<name>/base.html)
UI_DESIGN=default

# Footer Feedback button → prefilled GitHub issue (owner/name). Empty hides the button.
GITHUB_REPO=nordz0r/nopaste

# In-memory rate limit for POST /paste and slug updates (per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --------------------------------------------------------------------------
# FastAPI automatic documentation protection (/docs, /redoc, /openapi.json)
#
# Provide a comma-separated list of CIDR ranges or single IPs.
# When the list is empty or the variable is absent, documentation
# endpoints are accessible from any IP (convenient for development).
#
# Example:
# DOCS_ALLOWLIST=127.0.0.1/32,10.0.0.0/8
# --------------------------------------------------------------------------
DOCS_ALLOWLIST=
